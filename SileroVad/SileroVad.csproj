<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Dzmitry Shchamialiou</Authors>
		<PackageProjectUrl>https://github.com/DimQ1/SileroVad</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/DimQ1/SileroVad.git</RepositoryUrl>
		<RepositoryBranch>master</RepositoryBranch>
		<EnablePackageValidation>true</EnablePackageValidation>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyVersion>1.3.0.0</AssemblyVersion>
		<FileVersion>1.3.0.0</FileVersion>
		<PackageVersion>1.3.0.0</PackageVersion>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageTags>vad, library, onnx, silero</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<!--
			CPU only, so the package stays usable everywhere (no CUDA dependency).
			To run the model on a CUDA capable GPU, replace this reference with
			Microsoft.ML.OnnxRuntime.Gpu of the same version in the consuming application;
			both packages ship the same managed API.
		-->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="silero_vad.onnx">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="silero_vad_v4.onnx">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- Add a LICENSE.txt next to the csproj -->
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
