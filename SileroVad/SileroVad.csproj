<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Dzmitry Shchamialiou</Authors>
		<PackageProjectUrl>https://github.com/DimQ1/SileroVad</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/DimQ1/SileroVad.git</RepositoryUrl>
		<RepositoryBranch>master</RepositoryBranch>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!--
			net8.0 is the lowest target the managed ONNX Runtime package ships (it also ships netstandard2.0 and
			mobile assets); net8/9 consumers get their own asset, net10 consumers use the net10.0 one.
		-->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyVersion>2.1.0.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<PackageVersion>2.1.0</PackageVersion>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageTags>vad, library, onnx, silero</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Voice activity detection for .NET using the Silero VAD ONNX models (v5 and v4). Add one ONNX Runtime package with the same version as Microsoft.ML.OnnxRuntime.Managed (Microsoft.ML.OnnxRuntime for CPU, .Gpu for CUDA, .DirectML, .QNN, ...) and choose the execution provider through the VadExecutionProviders helpers.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Managed only on purpose: the consuming application picks exactly one native runtime
			(Microsoft.ML.OnnxRuntime for CPU, .Gpu for CUDA/TensorRT, .DirectML, .OpenVino, .QNN, ...)
			so that two packages never fight over the same native 'onnxruntime' binary, and so that the
			execution provider can be chosen freely (see VadExecutionProviders).
			VadRuntime.EnsureNativeRuntimeAvailable() reports a missing or mismatched runtime with a
			clear message instead of letting ONNX Runtime crash the process.
		-->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="silero_vad.onnx">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="silero_vad_v4.onnx">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- Add a LICENSE.txt next to the csproj -->
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
