<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Test every target framework of the library, so each shipped asset is exercised. -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<EnablePackageValidation>false</EnablePackageValidation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The application chooses the native runtime: exactly one runtime package, here the CPU build.
			Swap it for Microsoft.ML.OnnxRuntime.Gpu (or .DirectML, .OpenVino, .QNN, ...) of the same version
			to run on another execution provider; SileroVad itself only depends on the managed package.
		-->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SileroVad\SileroVad.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Speech excerpt used by the detection tests (16 kHz, mono, 16 bit PCM, 4 seconds). -->
		<None Update="assets\speech-16k.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- The bundled models, so that the path based constructors can be exercised. -->
		<None Include="..\SileroVad\silero_vad.onnx" Link="models\silero_vad.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\SileroVad\silero_vad_v4.onnx" Link="models\silero_vad_v4.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
