<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<EnablePackageValidation>false</EnablePackageValidation>
		<RootNamespace>SileroVad.Samples</RootNamespace>
		<AssemblyName>SileroVad.Samples</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SileroVad\SileroVad.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="3.1.0" />

		<!--
			An application has to bring its own native ONNX Runtime: SileroVad only references the managed
			package so that the execution provider is your choice. Swap this for
			Microsoft.ML.OnnxRuntime.Gpu (or .DirectML, .QNN, ...) of the same version to run on another provider.
		-->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The same audio the test suite uses, so that 'dotnet run' works without arguments. -->
		<Content Include="..\SileroVad.Tests\assets\speech-16k.wav" Link="assets\sample.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
